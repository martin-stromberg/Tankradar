<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
    <!-- Die ProjectReference auf Tankradar.MAUI bringt transitiv Microsoft.Maui.Resizetizer (buildTransitive) mit.
         Bild-/Icon-Verarbeitung wird hier nicht benötigt und würde zu Konflikten mit den bereits im
         Hauptprojekt erzeugten Ressourcen führen. -->
    <EnableMauiImageProcessing>false</EnableMauiImageProcessing>
    <EnableMauiFontProcessing>false</EnableMauiFontProcessing>
    <EnableMauiSplashProcessing>false</EnableMauiSplashProcessing>
    <!-- CsWinRT1032 (Collection-Expression auf IReadOnly*/IEnumerable) prüft WinRT-Trimming/AOT-Tauglichkeit;
         transitiv über die ProjectReference aktiv, für Testassemblys aber ohne Belang. -->
    <NoWarn>$(NoWarn);CsWinRT1032</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TestSupport\TransientRetry.cs" Link="TestSupport\TransientRetry.cs" />
    <Compile Include="..\TestSupport\TransientWait.cs" Link="TestSupport\TransientWait.cs" />
    <Compile Include="..\TestSupport\E2EStartupPolicy.cs" Link="TestSupport\E2EStartupPolicy.cs" />
    <Compile Include="..\TestSupport\BackupTestArchive.cs" Link="TestSupport\BackupTestArchive.cs" />
    <Compile Include="..\TestSupport\BackupEncryptedTestArchive.cs" Link="TestSupport\BackupEncryptedTestArchive.cs" />
    <Compile Include="..\TestSupport\RecordingLogger.cs" Link="TestSupport\RecordingLogger.cs" />
    <Compile Include="..\TestSupport\LoopbackHttpListener.cs" Link="TestSupport\LoopbackHttpListener.cs" />
    <Compile Include="..\TestSupport\MockOpenRouteServiceServer.cs" Link="TestSupport\MockOpenRouteServiceServer.cs" />
    <Compile Include="..\TestSupport\PolylineEncoder.cs" Link="TestSupport\PolylineEncoder.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tankradar.MAUI\Tankradar.MAUI.csproj" />
  </ItemGroup>

</Project>