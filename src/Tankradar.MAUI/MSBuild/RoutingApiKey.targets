<Project>

	<!-- OpenRouteService-API-Schlüssel beim Build: nie im Quellcode und nie im MSBuild-Log.
	Reihenfolge der Quellen (die erste mit Wert gewinnt): Umgebungsvariable TANKRADAR_ROUTING_API_KEY, Umgebungsvariable
	ROUTING_API_KEY (gleicher Name wie das GitHub-Secret), Eigenschaft RoutingApiKey in der nicht versionierten Datei
	routing.local.props im Repository-Root.
	Der Schlüssel kommt bewusst in keiner MSBuild-Eigenschaft, keinem Item-Metadatum und keinem Task-Parameter vor (diese würden bei
	-v:detailed, -v:diag und in Binlogs protokolliert): Die Aufgabe unten liest Umgebung und props-Datei selbst und schreibt die
	generierte Quelldatei mit dem Assembly-Metadatum direkt nach obj/. Ins Log gelangt nur „vorhanden: ja/nein“.
	Die props-Datei wird deshalb auch nicht per <Import> eingebunden (Imports würden im Binlog mitprotokolliert).
	Zur Laufzeit übernimmt die App den Schlüssel in Keychain bzw. Credential Locker. -->

	<PropertyGroup>
		<RoutingLocalPropsFile Condition="'$(RoutingLocalPropsFile)' == ''">$(MSBuildThisFileDirectory)..\..\..\routing.local.props</RoutingLocalPropsFile>
	</PropertyGroup>

	<UsingTask TaskName="WriteRoutingKeyAttribute"
	           TaskFactory="RoslynCodeTaskFactory"
	           AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<OutputFile ParameterType="System.String" Required="true" />
			<LocalPropsFile ParameterType="System.String" />
			<KeyFound ParameterType="System.Boolean" Output="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System" />
			<Using Namespace="System.IO" />
			<Using Namespace="System.Linq" />
			<Using Namespace="System.Text" />
			<Using Namespace="System.Xml.Linq" />
			<Code Type="Fragment" Language="cs"><![CDATA[
				string key = (Environment.GetEnvironmentVariable("TANKRADAR_ROUTING_API_KEY") ?? string.Empty).Trim();
				if (key.Length == 0)
				{
					key = (Environment.GetEnvironmentVariable("ROUTING_API_KEY") ?? string.Empty).Trim();
				}

				if (key.Length == 0 && !string.IsNullOrEmpty(LocalPropsFile) && File.Exists(LocalPropsFile))
				{
					try
					{
						var element = XDocument.Load(LocalPropsFile).Descendants().FirstOrDefault(e => e.Name.LocalName == "RoutingApiKey");
						key = (element?.Value ?? string.Empty).Trim();
					}
					catch (System.Xml.XmlException)
					{
						Log.LogWarning("routing.local.props ist kein gültiges XML und wird ignoriert.");
					}
				}

				// Alle Zeichen außer Buchstaben und Ziffern werden als \uXXXX-Escape ausgegeben: sicher gegen Anführungszeichen und Zeilenumbrüche im Wert.
				var literal = new StringBuilder();
				foreach (var c in key)
				{
					if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))
					{
						literal.Append(c);
					}
					else
					{
						literal.Append((char)92).Append("u").Append(((int)c).ToString("x4"));
					}
				}

				var content = "// <auto-generated />\n[assembly: System.Reflection.AssemblyMetadata(\"RoutingApiKey\", \"" + literal + "\")]\n";
				if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != content)
				{
					Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
					File.WriteAllText(OutputFile, content, new UTF8Encoding(false));
				}

				KeyFound = key.Length > 0;
				Log.LogMessage(MessageImportance.Normal, "Routing-Schlüssel beim Build vorhanden: " + (KeyFound ? "ja" : "nein"));
			]]></Code>
		</Task>
	</UsingTask>

	<Target Name="EmbedRoutingApiKey" BeforeTargets="CoreCompile">
		<PropertyGroup>
			<_RoutingKeyFile>$(IntermediateOutputPath)RoutingApiKey.g.cs</_RoutingKeyFile>
		</PropertyGroup>
		<WriteRoutingKeyAttribute OutputFile="$(_RoutingKeyFile)" LocalPropsFile="$(RoutingLocalPropsFile)" />
		<ItemGroup>
			<Compile Include="$(_RoutingKeyFile)" />
			<FileWrites Include="$(_RoutingKeyFile)" />
		</ItemGroup>
	</Target>

</Project>
