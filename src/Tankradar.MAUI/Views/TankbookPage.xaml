<?xml version="1.0" encoding="utf-8" ?>
<views:TankradarContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Tankradar.MAUI.Views"
             xmlns:texts="clr-namespace:Tankradar.MAUI.Resources.Texts"
             xmlns:vm="clr-namespace:Tankradar.MAUI.ViewModels"
             xmlns:tankbook="clr-namespace:Tankradar.MAUI.Models.Tankbook"
             xmlns:resources="clr-namespace:Tankradar.MAUI.Resources"
             x:DataType="vm:TankbookViewModel"
             x:Class="Tankradar.MAUI.Views.TankbookPage"
             Title="{x:Static texts:TankbookTexts.PageTitle}"
             BackgroundColor="{AppThemeBinding Light={StaticResource ColorBackgroundLight}, Dark={StaticResource ColorBackgroundDark}}">

    <views:TankradarContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <resources:TankbookStyles />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </views:TankradarContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource space-md}" Spacing="{StaticResource space-md}">

            <VerticalStackLayout Spacing="{StaticResource space-xs}">
                <Label Text="{x:Static texts:TankbookTexts.PageTitle}"
                       Style="{StaticResource headline-lg}"
                       TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}"
                       SemanticProperties.HeadingLevel="Level1"
                       AutomationId="TankbookPage.Headline" />
                <Label Text="{x:Static texts:TankbookTexts.Intro}"
                       Style="{StaticResource body-md}"
                       TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight}, Dark={StaticResource ColorTextSecondaryDark}}" />
            </VerticalStackLayout>

            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasStatusMessage}"
                   Style="{StaticResource body-md}"
                   TextColor="{StaticResource ColorErrorRed}"
                   AutomationId="Tankbook.Status" />

            <!-- Formular zum Anlegen und Bearbeiten (Bereich in der Seite, kein Dialog) -->
            <Border Style="{StaticResource TankbookCard}" IsVisible="{Binding IsFormOpen}">
                <VerticalStackLayout Spacing="{StaticResource space-sm}">
                    <Label Text="{Binding FormTitle}"
                           Style="{StaticResource headline-md}"
                           TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}"
                           SemanticProperties.HeadingLevel="Level2"
                           AutomationId="Tankbook.Form.Title" />

                    <!-- Name -->
                    <Label Text="{x:Static texts:TankbookTexts.NameLabel}" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource UnitFieldBorder}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding HasNameError}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource ColorErrorRed}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" x:DataType="Entry" Binding="{Binding Source={x:Reference NameEntry}, Path=IsFocused}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource ColorPrimaryTeal}" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Entry x:Name="NameEntry"
                               Text="{Binding FormName}"
                               MaxLength="{x:Static tankbook:VehicleLimits.MaxNameLength}"
                               SemanticProperties.Description="{x:Static texts:TankbookTexts.NameLabel}"
                               AutomationId="Tankbook.Form.Name" />
                    </Border>
                    <Label Text="{Binding NameError}"
                           IsVisible="{Binding HasNameError}"
                           Style="{StaticResource FieldError}"
                           AutomationId="Tankbook.Form.NameError" />

                    <!-- Kraftstoffart als feste Auswahl -->
                    <Label Text="{x:Static texts:TankbookTexts.FuelKindLabel}" Style="{StaticResource FieldLabel}" />
                    <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center"
                                BindableLayout.ItemsSource="{Binding FuelKindOptions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:IChoiceOption">
                                <Button Text="{Binding Label}"
                                        Command="{Binding SelectCommand}"
                                        Style="{StaticResource FuelKindChip}"
                                        SemanticProperties.Hint="{Binding SelectionHint}"
                                        AutomationId="{Binding AutomationKey, StringFormat='Tankbook.Form.FuelKind.{0}'}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource ColorPrimaryTeal}" />
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- Start-Kilometerstand mit festem Suffix „km“ -->
                    <Label Text="{x:Static texts:TankbookTexts.OdometerLabel}" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource UnitFieldBorder}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding HasOdometerError}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource ColorErrorRed}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" x:DataType="Entry" Binding="{Binding Source={x:Reference OdometerEntry}, Path=IsFocused}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource ColorPrimaryTeal}" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource space-sm}">
                            <Entry x:Name="OdometerEntry"
                                   Text="{Binding FormOdometer}"
                                   Placeholder="{x:Static texts:TankbookTexts.OdometerPlaceholder}"
                                   Keyboard="Numeric"
                                   MaxLength="12"
                                   SemanticProperties.Description="{x:Static texts:TankbookTexts.OdometerDescription}"
                                   AutomationId="Tankbook.Form.Odometer" />
                            <Label Grid.Column="1"
                                   Text="{x:Static texts:TankbookTexts.KilometerUnit}"
                                   Style="{StaticResource UnitLabel}"
                                   AutomationId="Tankbook.Form.OdometerUnit" />
                        </Grid>
                    </Border>
                    <Label Text="{Binding OdometerError}"
                           IsVisible="{Binding HasOdometerError}"
                           Style="{StaticResource FieldError}"
                           AutomationId="Tankbook.Form.OdometerError" />

                    <!-- Startverbrauch mit Suffix je nach Kraftstoffart -->
                    <Label Text="{x:Static texts:TankbookTexts.ConsumptionLabel}" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource UnitFieldBorder}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding HasConsumptionError}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource ColorErrorRed}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" x:DataType="Entry" Binding="{Binding Source={x:Reference ConsumptionEntry}, Path=IsFocused}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource ColorPrimaryTeal}" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource space-sm}">
                            <Entry x:Name="ConsumptionEntry"
                                   Text="{Binding FormConsumption}"
                                   Placeholder="{Binding ConsumptionPlaceholder}"
                                   Keyboard="Numeric"
                                   MaxLength="12"
                                   SemanticProperties.Description="{Binding ConsumptionDescription}"
                                   AutomationId="Tankbook.Form.Consumption" />
                            <Label Grid.Column="1"
                                   Text="{Binding ConsumptionUnit}"
                                   Style="{StaticResource UnitLabel}"
                                   AutomationId="Tankbook.Form.ConsumptionUnit" />
                        </Grid>
                    </Border>
                    <Label Text="{Binding ConsumptionError}"
                           IsVisible="{Binding HasConsumptionError}"
                           Style="{StaticResource FieldError}"
                           AutomationId="Tankbook.Form.ConsumptionError" />

                    <Button Text="{x:Static texts:TankbookTexts.Save}"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource TankbookButton}"
                            AutomationId="Tankbook.Form.Save" />
                    <Button Text="{x:Static texts:TankbookTexts.Cancel}"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource TankbookOutlineButton}"
                            SemanticProperties.Hint="{x:Static texts:TankbookTexts.CancelFormHint}"
                            AutomationId="Tankbook.Form.Cancel" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{x:Static texts:TankbookTexts.VehiclesHeading}"
                   Style="{StaticResource headline-md}"
                   TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}"
                   SemanticProperties.HeadingLevel="Level2" />

            <Label Text="{x:Static texts:TankbookTexts.NoVehicles}"
                   IsVisible="{Binding ShowEmptyHint}"
                   Style="{StaticResource body-md}"
                   TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight}, Dark={StaticResource ColorTextSecondaryDark}}"
                   AutomationId="Tankbook.Empty" />

            <!-- Fahrzeugkarten: Name, darunter „Kraftstoffart • …“ -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Vehicles}"
                                 IsVisible="{Binding HasVehicles}"
                                 Spacing="{StaticResource space-sm}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:VehicleItemViewModel">
                        <Border Style="{StaticResource TankbookCard}">
                            <VerticalStackLayout Spacing="{StaticResource space-xs}">
                                <Label Text="{Binding Name}"
                                       Style="{StaticResource headline-md}"
                                       TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}"
                                       AutomationId="Tankbook.Vehicle.Name" />
                                <Label Text="{Binding Details}"
                                       Style="{StaticResource body-md}"
                                       TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight}, Dark={StaticResource ColorTextSecondaryDark}}"
                                       AutomationId="Tankbook.Vehicle.Details" />
                                <Button Text="{x:Static texts:TankbookTexts.Entries}"
                                        Command="{Binding OpenEntriesCommand}"
                                        Style="{StaticResource TankbookButton}"
                                        SemanticProperties.Hint="{Binding VehicleHint}"
                                        AutomationId="Tankbook.Vehicle.Entries" />
                                <Button Text="{x:Static texts:TankbookTexts.Edit}"
                                        Command="{Binding EditCommand}"
                                        Style="{StaticResource TankbookOutlineButton}"
                                        SemanticProperties.Hint="{Binding VehicleHint}"
                                        AutomationId="Tankbook.Vehicle.Edit" />
                                <Button Text="{x:Static texts:TankbookTexts.Delete}"
                                        Command="{Binding DeleteCommand}"
                                        Style="{StaticResource TankbookOutlineButton}"
                                        TextColor="{StaticResource ColorErrorRed}"
                                        SemanticProperties.Hint="{Binding VehicleHint}"
                                        AutomationId="Tankbook.Vehicle.Delete" />

                                <!-- Rückfrage vor dem Löschen -->
                                <VerticalStackLayout IsVisible="{Binding IsConfirmingDelete}" Spacing="{StaticResource space-sm}">
                                    <Label Text="{Binding DeleteQuestion}"
                                           Style="{StaticResource body-md}"
                                           TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}"
                                           AutomationId="Tankbook.Vehicle.DeleteQuestion" />
                                    <Button Text="{Binding ConfirmDeleteLabel}"
                                            Command="{Binding ConfirmDeleteCommand}"
                                            Style="{StaticResource TankbookDangerButton}"
                                            SemanticProperties.Hint="{Binding ConfirmDeleteHint}"
                                            AutomationId="Tankbook.Vehicle.DeleteConfirm" />
                                    <Button Text="{x:Static texts:TankbookTexts.Cancel}"
                                            Command="{Binding CancelDeleteCommand}"
                                            Style="{StaticResource TankbookOutlineButton}"
                                            SemanticProperties.Hint="{Binding CancelDeleteHint}"
                                            AutomationId="Tankbook.Vehicle.DeleteCancel" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="{x:Static texts:TankbookTexts.AddVehicle}"
                    Command="{Binding AddVehicleCommand}"
                    IsVisible="{Binding IsFormClosed}"
                    Style="{StaticResource TankbookButton}"
                    AutomationId="Tankbook.AddVehicle" />
        </VerticalStackLayout>
    </ScrollView>

</views:TankradarContentPage>
