<?xml version="1.0" encoding="utf-8" ?>
<views:TankradarContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Tankradar.MAUI.Views"
             xmlns:texts="clr-namespace:Tankradar.MAUI.Resources.Texts"
             xmlns:vm="clr-namespace:Tankradar.MAUI.ViewModels"
             xmlns:search="clr-namespace:Tankradar.MAUI.Models.Search"
             xmlns:fav="clr-namespace:Tankradar.MAUI.Models.Favorites"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:DataType="vm:StationDetailViewModel"
             x:Class="Tankradar.MAUI.Views.StationDetailPage"
             Title="{x:Static texts:DetailTexts.PageTitle}"
             BackgroundColor="{AppThemeBinding Light={StaticResource ColorBackgroundLight}, Dark={StaticResource ColorBackgroundDark}}">

    <views:TankradarContentPage.Resources>
        <!-- Karten: Design-Tokens rounded-lg (16 px) und Schattenebene 1 -->
        <Style x:Key="DetailCard" TargetType="Border">
            <Setter Property="Padding" Value="{StaticResource space-md}" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorSurfaceLight}, Dark={StaticResource ColorSurfaceDark}}" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ColorBorderLight}, Dark={StaticResource ColorBorderDark}}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black" Offset="0,1" Radius="3" Opacity="0.04" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DetailChip" TargetType="Border">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 9999" />
        </Style>
        <Style x:Key="DetailActionButton" TargetType="Button">
            <Setter Property="MinimumHeightRequest" Value="{StaticResource MinimumTouchTarget}" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="FontFamily" Value="InterSemibold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BackgroundColor" Value="{StaticResource ColorPrimaryTeal}" />
            <Setter Property="TextColor" Value="White" />
            <Style.Triggers>
                <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#CBD5E1, Dark=#334155}" />
                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Auswahlschaltflächen der Karte "Favoritengruppen" (Umriss; ausgewählt: gefüllt) -->
        <Style x:Key="FavoriteChoiceButton" TargetType="Button">
            <Setter Property="MinimumHeightRequest" Value="{StaticResource MinimumTouchTarget}" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="FontFamily" Value="InterSemibold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource ColorBorderLight}, Dark={StaticResource ColorBorderDark}}" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorSurfaceLight}, Dark={StaticResource ColorSurfaceDark}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}" />
        </Style>
        <Style x:Key="FavoriteSecondaryButton" TargetType="Button" BasedOn="{StaticResource FavoriteChoiceButton}">
            <Setter Property="TextColor" Value="{StaticResource ColorErrorRed}" />
        </Style>
        <!-- Symbole der Info-Box (Material Symbols near_me und schedule, Apache-2.0) als Vektorpfade -->
        <x:String x:Key="IconNearMe">M21 3 3 10.53v.98l6.84 2.65L12.48 21h.98L21 3z</x:String>
        <x:String x:Key="IconSchedule">M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z</x:String>
    </views:TankradarContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Offline-Hinweis fest oben (scrollt nicht mit), wie auf der Suchseite -->
        <Border Grid.Row="0"
                Style="{StaticResource DetailChip}"
                Margin="{StaticResource space-md}"
                Padding="{StaticResource space-md}"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{StaticResource ColorTertiaryAmber}"
                IsVisible="{Binding IsOffline}">
            <Label Text="{Binding OfflineMessage}"
                   Style="{StaticResource body-md}"
                   TextColor="{StaticResource ColorTextPrimaryLight}"
                   AutomationId="Detail.OfflineBanner" />
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{StaticResource space-md}"
                                 Spacing="{StaticResource space-md}">

                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding HasStatusMessage}"
                       Style="{StaticResource body-md}"
                       TextColor="{StaticResource ColorErrorRed}"
                       AutomationId="Detail.StatusMessage" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource ColorPrimaryTeal}" />

                <VerticalStackLayout IsVisible="{Binding HasDetail}" Spacing="{StaticResource space-md}">

                    <Border Style="{StaticResource DetailCard}" BindingContext="{Binding Detail}" x:DataType="search:StationDetailItem">
                        <VerticalStackLayout Spacing="{StaticResource space-xs}">
                            <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center">
                                <Border Style="{StaticResource DetailChip}"
                                        Margin="0,0,8,4"
                                        BackgroundColor="{AppThemeBinding Light=#190F766E, Dark=#33006C49}"
                                        IsVisible="{Binding HasBrand}">
                                    <Label Text="{Binding BrandText}"
                                           Style="{StaticResource body-sm}"
                                           TextColor="{AppThemeBinding Light={StaticResource ColorPrimaryTeal}, Dark={StaticResource ColorSecondaryEmerald}}"
                                           AutomationId="Detail.Brand" />
                                </Border>
                                <Border Style="{StaticResource DetailChip}"
                                        Margin="0,0,8,4"
                                        BackgroundColor="#6FFBBE"
                                        IsVisible="{Binding HasLivePrices}">
                                    <Label Text="{Binding PriceStatusText}"
                                           Style="{StaticResource body-sm}"
                                           TextColor="#002113"
                                           AutomationId="Detail.PriceStatus" />
                                </Border>
                                <Border Style="{StaticResource DetailChip}"
                                        Margin="0,0,8,4"
                                        BackgroundColor="{StaticResource ColorTertiaryAmber}"
                                        IsVisible="{Binding HasStalePrice}">
                                    <Label Text="{Binding PriceStatusText}"
                                           Style="{StaticResource body-sm}"
                                           TextColor="{StaticResource ColorTextPrimaryLight}"
                                           AutomationId="Detail.PriceStatusStale" />
                                </Border>
                                <Border Style="{StaticResource DetailChip}"
                                        Margin="0,0,8,4"
                                        BackgroundColor="{StaticResource ColorTertiaryAmber}"
                                        IsVisible="{Binding HasUnconfirmedPrice}">
                                    <Label Text="{x:Static texts:PriceTexts.PriceUnconfirmed}"
                                           Style="{StaticResource body-sm}"
                                           TextColor="{StaticResource ColorTextPrimaryLight}"
                                           AutomationId="Detail.Hint.Unconfirmed" />
                                </Border>
                            </FlexLayout>
                            <Label Text="{Binding Name}"
                                   Style="{StaticResource headline-lg}"
                                   TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}"
                                   AutomationId="Detail.Name" />
                            <Label Text="{Binding AddressText}"
                                   IsVisible="{Binding HasAddress}"
                                   Style="{StaticResource body-md}"
                                   TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight}, Dark={StaticResource ColorTextSecondaryDark}}"
                                   AutomationId="Detail.Address" />

                            <!-- Info-Box mit Symbolen: Entfernung, Öffnungsstatus, Automat 24/7 -->
                            <Border Margin="0,8,0,0"
                                    Padding="12"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark={StaticResource ColorBackgroundDark}}"
                                    IsVisible="{Binding HasInfoBox}">
                                <VerticalStackLayout Spacing="8">
                                    <HorizontalStackLayout Spacing="8" IsVisible="{Binding HasDistance}">
                                        <shapes:Path Data="{StaticResource IconNearMe}"
                                                     Fill="{AppThemeBinding Light={StaticResource ColorPrimaryTeal}, Dark={StaticResource ColorSecondaryEmerald}}"
                                                     Aspect="Uniform" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"
                                                     AutomationProperties.IsInAccessibleTree="False" />
                                        <Label Text="{Binding DistanceText}"
                                               Style="{StaticResource body-md}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}"
                                               AutomationId="Detail.Distance" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="8" IsVisible="{Binding HasOpeningStatusOrAutomat}">
                                        <shapes:Path Data="{StaticResource IconSchedule}"
                                                     Fill="{AppThemeBinding Light={StaticResource ColorPrimaryTeal}, Dark={StaticResource ColorSecondaryEmerald}}"
                                                     Aspect="Uniform" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"
                                                     AutomationProperties.IsInAccessibleTree="False" />
                                        <Label Text="{Binding OpeningStatusText}"
                                               IsVisible="{Binding HasOpeningStatus}"
                                               Style="{StaticResource body-md}"
                                               VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}"
                                               AutomationId="Detail.Opening" />
                                        <Border Style="{StaticResource DetailChip}"
                                                VerticalOptions="Center"
                                                BackgroundColor="{StaticResource ColorPrimaryTeal}"
                                                IsVisible="{Binding IsAutomatedStation}">
                                            <Label Text="{x:Static texts:DetailTexts.Automated247}"
                                                   Style="{StaticResource body-sm}"
                                                   TextColor="White"
                                                   AutomationId="Detail.Hint.Automated" />
                                        </Border>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{x:Static texts:DetailTexts.PricesHeading}"
                           Style="{StaticResource headline-md}"
                           TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}" />

                    <Label Text="{x:Static texts:DetailTexts.NoPrices}"
                           IsVisible="{Binding ShowNoPrices}"
                           Style="{StaticResource body-md}"
                           TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight}, Dark={StaticResource ColorTextSecondaryDark}}"
                           AutomationId="Detail.NoPrices" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Detail.PriceLines}"
                                         Spacing="{StaticResource space-sm}"
                                         AutomationId="Detail.Prices">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="search:StationPriceLine">
                                <Border Style="{StaticResource DetailCard}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource space-sm}">
                                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding FuelLabel}"
                                                   Style="{StaticResource headline-md}"
                                                   TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}"
                                                   AutomationId="{Binding FuelType, StringFormat='Detail.Fuel.{0}'}" />
                                            <Label Text="{Binding AgeText}"
                                                   Style="{StaticResource body-sm}"
                                                   TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight}, Dark={StaticResource ColorTextSecondaryDark}}"
                                                   AutomationId="{Binding FuelType, StringFormat='Detail.Age.{0}'}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsStale}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource ColorTertiaryAmber}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>
                                        <!-- Preis wie im Entwurf: dritte Nachkommastelle hochgestellt, Einheit €/L; Bedienhilfen lesen den ganzen Preis über die Hauptzahl -->
                                        <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                            <Label Text="{Binding PriceMainText}"
                                                   Style="{StaticResource price-hero}"
                                                   TextColor="{AppThemeBinding Light={StaticResource ColorPrimaryTeal}, Dark={StaticResource ColorSecondaryEmerald}}"
                                                   SemanticProperties.Description="{Binding PriceSpokenText}"
                                                   AutomationId="{Binding FuelType, StringFormat='Detail.Price.{0}'}" />
                                            <Label Text="{Binding PriceFractionText}"
                                                   Style="{StaticResource headline-md}"
                                                   VerticalOptions="Start"
                                                   TextColor="{AppThemeBinding Light={StaticResource ColorPrimaryTeal}, Dark={StaticResource ColorSecondaryEmerald}}"
                                                   AutomationProperties.IsInAccessibleTree="False" />
                                            <Label Text="{Binding PriceUnitText}"
                                                   Style="{StaticResource body-sm}"
                                                   VerticalOptions="End"
                                                   Margin="3,0,0,4"
                                                   TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight}, Dark={StaticResource ColorTextSecondaryDark}}"
                                                   AutomationProperties.IsInAccessibleTree="False" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Border Style="{StaticResource DetailCard}"
                            BindingContext="{Binding Detail}"
                            x:DataType="search:StationDetailItem"
                            IsVisible="{Binding HasOpeningHours}">
                        <VerticalStackLayout Spacing="{StaticResource space-xs}">
                            <Label Text="{x:Static texts:DetailTexts.OpeningHoursHeading}"
                                   Style="{StaticResource headline-md}"
                                   TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding OpeningHours}" Spacing="{StaticResource space-xs}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="search:OpeningHoursLine">
                                        <Label Text="{Binding DisplayText}"
                                               Style="{StaticResource body-md}"
                                               TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}"
                                               AutomationId="Detail.OpeningHours" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Text="{Binding OpeningHoursAgeText}"
                                   Style="{StaticResource body-sm}"
                                   TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight}, Dark={StaticResource ColorTextSecondaryDark}}"
                                   AutomationId="Detail.OpeningHoursAge" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Karte "Favoritengruppen" (Designentwurf tankstellen_details_favoriten): zugeordnete Gruppen, Hinzufügen und Entfernen direkt in der Karte -->
                    <Border Style="{StaticResource DetailCard}"
                            BindingContext="{Binding Favorites}"
                            x:DataType="vm:StationFavoritesViewModel">
                        <VerticalStackLayout Spacing="{StaticResource space-sm}">
                            <Label Text="{x:Static texts:FavoritesTexts.DetailHeading}"
                                   Style="{StaticResource headline-md}"
                                   TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}" />

                            <Label Text="{x:Static texts:FavoritesTexts.NotAssigned}"
                                   IsVisible="{Binding HasNoAssignedGroups}"
                                   Style="{StaticResource body-md}"
                                   TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight}, Dark={StaticResource ColorTextSecondaryDark}}"
                                   AutomationId="Detail.Favorites.None" />

                            <VerticalStackLayout IsVisible="{Binding HasAssignedGroups}" Spacing="4">
                                <Label Text="{x:Static texts:FavoritesTexts.AssignedTo}"
                                       Style="{StaticResource body-sm}"
                                       TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight}, Dark={StaticResource ColorTextSecondaryDark}}" />
                                <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center"
                                            BindableLayout.ItemsSource="{Binding AssignedGroups}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="fav:FavoriteGroup">
                                            <Border Style="{StaticResource DetailChip}"
                                                    Margin="0,0,8,4"
                                                    Padding="12,6"
                                                    BackgroundColor="{AppThemeBinding Light=#190F766E, Dark=#33006C49}">
                                                <Label Text="{Binding Name}"
                                                       Style="{StaticResource body-md}"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource ColorPrimaryTeal}, Dark={StaticResource ColorSecondaryEmerald}}"
                                                       AutomationId="Detail.Favorites.Group" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>

                            <Label Text="{Binding StatusMessage}"
                                   IsVisible="{Binding HasStatusMessage}"
                                   Style="{StaticResource body-md}"
                                   TextColor="{StaticResource ColorErrorRed}"
                                   AutomationId="Detail.Favorites.Status" />

                            <Button Text="{x:Static texts:FavoritesTexts.AddToFavorites}"
                                    Command="{Binding ToggleAddCommand}"
                                    Style="{StaticResource DetailActionButton}"
                                    AutomationId="Detail.Favorites.Add" />

                            <!-- Auswahl einer bestehenden Gruppe oder Anlegen einer neuen -->
                            <VerticalStackLayout IsVisible="{Binding IsAddOpen}" Spacing="{StaticResource space-sm}">
                                <Label Text="{x:Static texts:FavoritesTexts.ChooseGroup}"
                                       IsVisible="{Binding HasAddOptions}"
                                       Style="{StaticResource body-md}"
                                       TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding AddOptions}"
                                                     IsVisible="{Binding HasAddOptions}"
                                                     Spacing="{StaticResource space-xs}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GroupOptionViewModel">
                                            <Button Text="{Binding Name}"
                                                    Command="{Binding InvokeCommand}"
                                                    Style="{StaticResource FavoriteChoiceButton}"
                                                    AutomationId="Detail.Favorites.Pick" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Label Text="{x:Static texts:FavoritesTexts.AllGroupsAssigned}"
                                       IsVisible="{Binding HasNoAddOptions}"
                                       Style="{StaticResource body-sm}"
                                       TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight}, Dark={StaticResource ColorTextSecondaryDark}}"
                                       AutomationId="Detail.Favorites.AllAssigned" />
                                <Label Text="{x:Static texts:FavoritesTexts.OrNewGroup}"
                                       Style="{StaticResource body-md}"
                                       TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}" />
                                <Entry Text="{Binding NewGroupName}"
                                       Placeholder="{x:Static texts:FavoritesTexts.NameLabel}"
                                       MaxLength="40"
                                       ReturnCommand="{Binding CreateAndAddCommand}"
                                       SemanticProperties.Description="{x:Static texts:FavoritesTexts.NameLabel}"
                                       AutomationId="Detail.Favorites.NewName" />
                                <Button Text="{x:Static texts:FavoritesTexts.CreateAndAdd}"
                                        Command="{Binding CreateAndAddCommand}"
                                        IsEnabled="{Binding CanCreate}"
                                        Style="{StaticResource DetailActionButton}"
                                        AutomationId="Detail.Favorites.NewCreate" />
                                <Button Text="{x:Static texts:FavoritesTexts.Cancel}"
                                        Command="{Binding CancelCommand}"
                                        Style="{StaticResource FavoriteChoiceButton}"
                                        AutomationId="Detail.Favorites.Cancel" />
                            </VerticalStackLayout>

                            <Button Text="{x:Static texts:FavoritesTexts.RemoveFromFavorites}"
                                    Command="{Binding RemoveCommand}"
                                    IsVisible="{Binding HasAssignedGroups}"
                                    Style="{StaticResource FavoriteSecondaryButton}"
                                    AutomationId="Detail.Favorites.Remove" />

                            <!-- Bei mehreren Gruppen: Auswahl, aus welchen die Tankstelle entfernt wird -->
                            <VerticalStackLayout IsVisible="{Binding IsRemoveOpen}" Spacing="{StaticResource space-sm}">
                                <Label Text="{x:Static texts:FavoritesTexts.ChooseRemove}"
                                       Style="{StaticResource body-md}"
                                       TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding RemoveOptions}" Spacing="{StaticResource space-xs}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GroupOptionViewModel">
                                            <Button Text="{Binding Name}"
                                                    Command="{Binding InvokeCommand}"
                                                    Style="{StaticResource FavoriteChoiceButton}"
                                                    SemanticProperties.Hint="{Binding SelectionHint}"
                                                    AutomationId="Detail.Favorites.RemoveChoice">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource ColorPrimaryTeal}" />
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Button Text="{x:Static texts:FavoritesTexts.ConfirmRemove}"
                                        Command="{Binding ConfirmRemoveCommand}"
                                        IsEnabled="{Binding CanConfirmRemove}"
                                        Style="{StaticResource DetailActionButton}"
                                        AutomationId="Detail.Favorites.RemoveConfirm" />
                                <Button Text="{x:Static texts:FavoritesTexts.Cancel}"
                                        Command="{Binding CancelCommand}"
                                        Style="{StaticResource FavoriteChoiceButton}"
                                        AutomationId="Detail.Favorites.CancelRemove" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Label Text="{Binding SourceNote}"
                       IsVisible="{Binding HasSourceNote}"
                       Style="{StaticResource body-md}"
                       TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight}, Dark={StaticResource ColorTextSecondaryDark}}"
                       AutomationId="Detail.SourceNote" />

                <Button Text="{x:Static texts:DetailTexts.Refresh}"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding CanRefresh}"
                        Style="{StaticResource DetailActionButton}"
                        AutomationId="Detail.Refresh" />

                <Label Text="{x:Static texts:PriceTexts.Attribution}"
                       Style="{StaticResource body-sm}"
                       TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight}, Dark={StaticResource ColorTextSecondaryDark}}"
                       AutomationId="Detail.Attribution" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</views:TankradarContentPage>
