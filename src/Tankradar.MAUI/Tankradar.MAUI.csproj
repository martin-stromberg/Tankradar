<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Zielframeworks sind per Eigenschaft ausblendbar (Standard: alle Plattformen des Betriebssystems).
		Die CI blendet damit je Job nicht benötigte Ziele aus, damit weder Workload-Installation noch Restore
		(NETSDK1147 bei fehlender Workload) an fremden Zielframeworks scheitern:
		IncludeAndroidTarget / IncludeIosTarget / IncludeMacCatalystTarget / IncludeWindowsTarget = false. -->
		<IncludeAndroidTarget Condition="'$(IncludeAndroidTarget)' == ''">true</IncludeAndroidTarget>
		<IncludeIosTarget Condition="'$(IncludeIosTarget)' == ''">true</IncludeIosTarget>
		<IncludeMacCatalystTarget Condition="'$(IncludeMacCatalystTarget)' == ''">true</IncludeMacCatalystTarget>
		<IncludeWindowsTarget Condition="'$(IncludeWindowsTarget)' == ''">true</IncludeWindowsTarget>

		<TargetFrameworks Condition="'$(IncludeAndroidTarget)' == 'true'">net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="'$(IncludeIosTarget)' == 'true' And !$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="'$(IncludeMacCatalystTarget)' == 'true' And !$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="'$(IncludeWindowsTarget)' == 'true' And $([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>Tankradar.MAUI</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>

		<!-- Display name -->
		<ApplicationTitle>Tankatlas</ApplicationTitle>
		<Product>Tankatlas</Product>
		<AssemblyTitle>Tankatlas</AssemblyTitle>

		<!-- App Identifier (Bundle-ID, siehe Services/AppConfiguration.cs) -->
		<ApplicationId>de.martinstromberg.tankradar</ApplicationId>

		<!-- Versions -->
		<Version>0.1.0</Version>
		<InformationalVersion>0.1.0</InformationalVersion>
		<ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

		<!-- iOS 16 ist gemäß Stakeholder-Entscheidung die Mindestversion (siehe project-plan.md) -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">16.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<!-- Windows 10.0.19041 (Build 19041) ist die Mindestversion für Deployment (MAUI-Standard, siehe plan.md) -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0F766E" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F766E" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*.ttf" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
		<!-- Hebt die transitiv gezogene, als anfällig gemeldete Version 2.1.11 (GHSA-2m69-gcr7-jv3q) an. -->
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- Tankerkönig-API-Schlüssel: Übernahme ohne MSBuild-Eigenschaft, siehe MSBuild\TankerkoenigApiKey.targets (Schlüssel gelangt nie ins Build-Log). -->
	<Import Project="MSBuild\TankerkoenigApiKey.targets" />

	<ItemGroup>
		<Compile Include="..\TestSupport\TestDataPaths.cs" Link="TestSupport\TestDataPaths.cs" />
	</ItemGroup>

</Project>
