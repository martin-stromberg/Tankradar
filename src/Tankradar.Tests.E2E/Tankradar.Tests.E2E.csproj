<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FlaUI.Core" />
    <PackageReference Include="FlaUI.UIA3" />
    <!-- Direkter Zugriff auf die isolierte Testdatenbank der App (Vorgänge für das Tankbuch einfügen und zählen); gleiche, nicht anfällige SQLite-Version wie das Hauptprojekt. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TestSupport\BackupTestArchive.cs" Link="TestSupport\BackupTestArchive.cs" />
    <Compile Include="..\TestSupport\BackupTestTampering.cs" Link="TestSupport\BackupTestTampering.cs" />
    <Compile Include="..\TestSupport\TestDataPaths.cs" Link="TestSupport\TestDataPaths.cs" />
    <Compile Include="..\TestSupport\TransientRetry.cs" Link="TestSupport\TransientRetry.cs" />
    <Compile Include="..\TestSupport\TransientWait.cs" Link="TestSupport\TransientWait.cs" />
    <Compile Include="..\TestSupport\E2EStartupPolicy.cs" Link="TestSupport\E2EStartupPolicy.cs" />
    <Compile Include="..\TestSupport\MockTankerkoenigServer.cs" Link="TestSupport\MockTankerkoenigServer.cs" />
    <Compile Include="..\TestSupport\MockNominatimServer.cs" Link="TestSupport\MockNominatimServer.cs" />
    <Compile Include="..\TestSupport\MockOpenRouteServiceServer.cs" Link="TestSupport\MockOpenRouteServiceServer.cs" />
    <Compile Include="..\TestSupport\PolylineEncoder.cs" Link="TestSupport\PolylineEncoder.cs" />
    <Compile Include="..\TestSupport\MockTileServer.cs" Link="TestSupport\MockTileServer.cs" />
    <Compile Include="..\TestSupport\LoopbackHttpListener.cs" Link="TestSupport\LoopbackHttpListener.cs" />
    <Compile Include="..\TestSupport\TestCategories.cs" Link="TestSupport\TestCategories.cs" />
    <Compile Include="..\TestSupport\TempDirectoryCleanup.cs" Link="TestSupport\TempDirectoryCleanup.cs" />
    <Compile Include="..\TestSupport\FlakyConventionTests.cs" Link="TestSupport\FlakyConventionTests.cs" />
  </ItemGroup>

</Project>
