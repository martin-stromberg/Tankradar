#!/usr/bin/env sh
# Pre-Commit-Hook: lokale Qualitätssicherung für Tankradar.
#
# Blockiert direkte Commits auf main/staging (Branch-Schutz) sowie Verstöße
# gegen die blockierenden Checks (Code-Formatierung, XML-Dokumentation,
# Übersetzungs-Konsistenz, verbotene Muster). Enum-Testabdeckung und
# Platzhalter-Implementierungen laufen weiterhin im Warn-Modus, damit
# Work-in-Progress committet werden kann; sie müssen spätestens vor dem
# Push (siehe .githooks/pre-push) behoben sein.
#
# Notfall-Fallback: SKIP_HOOKS=1 git commit ... überspringt alle Hooks
# (mit sichtbarer Warnung auf stderr).
set -u

if [ "${SKIP_HOOKS:-}" = "1" ]; then
  echo "WARNUNG: SKIP_HOOKS=1 gesetzt - alle Git-Hooks werden übersprungen." >&2
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"

# --- Branch-Schutz (blockierend) ---
branch_name="$(git symbolic-ref --quiet --short HEAD || true)"
case "$branch_name" in
  main|staging)
    echo "FEHLER: Direkte Commits auf '$branch_name' sind nicht erlaubt. Bitte einen Feature-Branch verwenden und per Pull Request mergen." >&2
    exit 1
    ;;
esac

# --- Python-Interpreter ermitteln (python3 bevorzugt, sonst python) ---
if command -v python3 >/dev/null 2>&1; then
  PYTHON="python3"
elif command -v python >/dev/null 2>&1; then
  PYTHON="python"
else
  echo "FEHLER: Weder 'python3' noch 'python' im PATH gefunden. Die Git-Hooks benötigen Python 3.x." >&2
  exit 1
fi

# Führt einen Python-Check blockierend aus; bricht den Commit bei Verstößen ab.
block_check() {
  label="$1"
  shift
  echo "Prüfe: $label ..."
  if ! "$PYTHON" "$@"; then
    echo "FEHLER: $label meldet Verstöße (siehe Ausgabe oben). Commit abgebrochen." >&2
    echo
    exit 1
  fi
  echo
}

# Führt einen Python-Check aus; meldet Verstöße als Warnung, blockiert aber nicht.
warn_check() {
  label="$1"
  shift
  echo "Prüfe: $label ..."
  if ! "$PYTHON" "$@"; then
    echo "WARNUNG: $label meldet Verstöße (siehe Ausgabe oben). Der Commit wird trotzdem fortgesetzt, muss aber vor dem Push behoben sein." >&2
  fi
  echo
}

# --- Blockierende Checks auf gestagte Dateien ---
block_check "Code-Formatierung (format-code-style-check.py --strict)" "$repo_root/.githooks/format-code-style-check.py" --strict
block_check "XML-Dokumentation (csproj-xmldoc-check.py)" "$repo_root/.githooks/csproj-xmldoc-check.py"
block_check "Übersetzungs-Konsistenz (translation-check.py)" "$repo_root/.githooks/translation-check.py"
block_check "Verbotene Muster / Secrets (forbidden-patterns-check.py --strict)" "$repo_root/.githooks/forbidden-patterns-check.py" --strict

# --- Warnende Checks (nicht blockierend) ---
warn_check "Enum-Testabdeckung (enum-coverage-check.py)" "$repo_root/.githooks/enum-coverage-check.py"
warn_check "Platzhalter-Implementierungen (no-notimplemented-check.py)" "$repo_root/.githooks/no-notimplemented-check.py"

# --- Optionale .NET-Prüfprojekte (falls vorhanden), nur Warnung ---
if command -v dotnet >/dev/null 2>&1; then
  solution_file="$(find "$repo_root" -maxdepth 3 -type f \( -name '*.sln' -o -name '*.slnx' \) | head -n 1 || true)"
  if [ -n "$solution_file" ]; then
    secret_scan_proj="$(find "$repo_root" -type f -name 'SecretScan.csproj' | head -n 1 || true)"
    if [ -n "$secret_scan_proj" ]; then
      echo "Führe SecretScan aus..."
      if ! dotnet run --no-restore --project "$secret_scan_proj" -- --root "$repo_root" --solution "$solution_file"; then
        echo "WARNUNG: SecretScan meldet Verstöße." >&2
      fi
    fi

    markdown_check_proj="$(find "$repo_root" -type f -name 'MarkdownLinkCheck.csproj' | head -n 1 || true)"
    if [ -n "$markdown_check_proj" ]; then
      echo "Führe MarkdownLinkCheck aus..."
      if ! dotnet run --no-restore --project "$markdown_check_proj" -- --root "$repo_root" --solution "$solution_file"; then
        echo "WARNUNG: MarkdownLinkCheck meldet Verstöße." >&2
      fi
    fi
  fi
fi

echo "Pre-Commit-Prüfungen erfolgreich abgeschlossen (etwaige Warnungen siehe oben)."
exit 0
